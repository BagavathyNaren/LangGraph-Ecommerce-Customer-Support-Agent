*.py[cod]
*$py.class

# Environment / secrets
.env
venv
env
env.yaml

# IDE
.vscode
.idea

# Evaluation results (generated at runtime)
evaluation/results/

# GHA credential files (must never be in production image)
gha-creds-*.json

# OS artifacts
.DS_Store
Thumbs.db
